vector conc.snapshot_acquire_release covers CONC-005 CONC-006 DOC-032
  create_doc bytes="hello"
  expect CDIN_OK handle=k1
  replace handle=k1 start=5 end=5 bytes=" world" expected_version=0
  expect CDIN_OK new_version=1
  snapshot_acquire handle=k1
  expect CDIN_OK handle=ks1 version=1
  snapshot_release handle=ks1
  expect CDIN_OK
  close_doc handle=k1
  expect CDIN_OK

vector conc.snapshot_immutable covers CONC-005 DOC-032
  create_doc bytes="hello"
  expect CDIN_OK handle=k1
  snapshot_acquire handle=k1
  expect CDIN_OK handle=ks1 version=0
  replace handle=k1 start=5 end=5 bytes=" world" expected_version=0
  expect CDIN_OK new_version=1
  snapshot_read handle=ks1 start=0 end=5
  expect CDIN_OK data="hello"
  snapshot_release handle=ks1
  expect CDIN_OK
  close_doc handle=k1
  expect CDIN_OK

vector conc.acceptance_sequence covers CONC-003 CONC-004
  create_doc bytes="abc"
  expect CDIN_OK handle=k1
  replace handle=k1 start=0 end=1 bytes="1" expected_version=0
  expect CDIN_OK new_version=1 seq=1
  replace handle=k1 start=1 end=2 bytes="2" expected_version=1
  expect CDIN_OK new_version=2 seq=2
  replace handle=k1 start=2 end=3 bytes="3" expected_version=2
  expect CDIN_OK new_version=3 seq=3
  close_doc handle=k1
  expect CDIN_OK


vector conc.shutdown_graceful covers CONC-020 CONC-021
  create_doc bytes="hello"
  expect CDIN_OK handle=k1
  shutdown mode=graceful
  expect CDIN_OK
  set_metadata handle=k1 value=17
  expect CDIN_SHUTDOWN
  create_doc
  expect CDIN_SHUTDOWN
  close_doc handle=k1
  expect CDIN_OK

vector conc.shutdown_is_per_kernel covers CONC-020 CONC-021 ABI-012
  create allocator=counting
  expect CDIN_OK
  shutdown mode=graceful
  expect CDIN_OK
  create allocator=counting
  expect CDIN_OK
  create_doc bytes="hello"
  expect CDIN_OK handle=k3
  close_doc handle=k3
  expect CDIN_OK
