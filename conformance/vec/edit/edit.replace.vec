vector edit.replace.insert covers EDIT-002 EDIT-010 EDIT-012 DOC-011
  create_doc bytes="hello world"
  expect CDIN_OK handle=k1
  replace handle=k1 start=5 end=5 bytes=" beautiful" expected_version=0
  expect CDIN_OK new_version=1 start=5 removed=0 inserted=10 new_length=21
  read handle=k1 start=0 end=21
  expect CDIN_OK data="hello beautiful world"

vector edit.replace.delete covers EDIT-002 EDIT-010 EDIT-012 DOC-011
  create_doc bytes="hello world"
  expect CDIN_OK handle=k1
  replace handle=k1 start=5 end=11 bytes="" expected_version=0
  expect CDIN_OK new_version=1 start=5 removed=6 inserted=0 new_length=5
  read handle=k1 start=0 end=5
  expect CDIN_OK data="hello"

vector edit.replace.forall covers EDIT-002 EDIT-010 EDIT-012 DOC-011
  create_doc bytes="abc"
  expect CDIN_OK handle=k1
  replace handle=k1 start=1 end=2 bytes="XYZ" expected_version=0
  expect CDIN_OK new_version=1 start=1 removed=1 inserted=3 new_length=5
  read handle=k1 start=0 end=5
  expect CDIN_OK data="aXYZc"

vector edit.replace.at_end covers EDIT-002 POS-011 EDIT-010 EDIT-012
  create_doc bytes="abc"
  expect CDIN_OK handle=k1
  replace handle=k1 start=3 end=3 bytes="DEF" expected_version=0
  expect CDIN_OK new_version=1 start=3 removed=0 inserted=3 new_length=6
  read handle=k1 start=0 end=6
  expect CDIN_OK data="abcDEF"

vector edit.replace.out_of_range covers POS-011 ERR-004
  create_doc bytes="abc"
  expect CDIN_OK handle=k1
  replace handle=k1 start=0 end=10 bytes="X" expected_version=0
  expect CDIN_OUT_OF_RANGE
  version handle=k1
  expect CDIN_OK version=0

vector edit.replace.invalid_handle covers EDIT-011 ERR-004
  replace handle=k99 start=0 end=1 bytes="X" expected_version=0
  expect CDIN_INVALID_HANDLE

vector edit.replace.limit_exceeded covers EDIT-013 KERNEL-013
  create_doc bytes="abc"
  expect CDIN_OK handle=k1
  replace handle=k1 start=0 end=3 bytes="" expected_version=0
  expect CDIN_OK new_version=1 start=0 removed=3 inserted=0 new_length=0
