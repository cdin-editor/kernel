vector edit.version.stale_rejected covers EDIT-004 EDIT-006 ERR-002 ERR-010 DOC-011
  create_doc bytes="abc"
  expect CDIN_OK handle=k1
  replace handle=k1 start=1 end=2 bytes="X" expected_version=0
  expect CDIN_OK new_version=1 start=1 removed=1 inserted=1 new_length=3
  replace handle=k1 start=0 end=1 bytes="Z" expected_version=0
  expect CDIN_STALE_VERSION
  version handle=k1
  expect CDIN_OK version=1
  read handle=k1 start=0 end=3
  expect CDIN_OK data="aXc"

vector edit.version.any_version covers EDIT-003 EDIT-004
  create_doc bytes="abc"
  expect CDIN_OK handle=k1
  replace handle=k1 start=1 end=2 bytes="X" expected_version=18446744073709551615
  expect CDIN_OK new_version=1 start=1 removed=1 inserted=1 new_length=3

vector edit.version.failed_edit_no_version covers EDIT-011 ERR-002
  create_doc bytes="abc"
  expect CDIN_OK handle=k1
  replace handle=k1 start=0 end=10 bytes="X" expected_version=0
  expect CDIN_OUT_OF_RANGE
  version handle=k1
  expect CDIN_OK version=0
  len handle=k1
  expect CDIN_OK length=3
