vector notif.basic.subscribe_drain covers NOTIF-001 NOTIF-002 NOTIF-003 NOTIF-005 NOTIF-008 NOTIF-009
  create_doc bytes="abc"
  expect CDIN_OK handle=k1
  subscribe handle=k1
  expect CDIN_OK version=0 handle=ks1
  replace handle=k1 start=1 end=2 bytes="X" expected_version=0
  expect CDIN_OK new_version=1
  drain handle=ks1
  expect CDIN_OK count=1 from_version=0 to_version=1
  unsubscribe handle=ks1
  expect CDIN_OK
  close_doc handle=k1
  expect CDIN_OK

vector notif.basic.closed_event covers NOTIF-010 NOTIF-012
  create_doc bytes="abc"
  expect CDIN_OK handle=k1
  subscribe handle=k1
  expect CDIN_OK version=0 handle=ks1
  close_doc handle=k1
  expect CDIN_OK
  drain handle=ks1
  expect CDIN_OK count=1 kind=closed
  unsubscribe handle=ks1
  expect CDIN_OK

vector notif.basic.unsubscribe_discards covers NOTIF-010
  create_doc bytes="abc"
  expect CDIN_OK handle=k1
  subscribe handle=k1
  expect CDIN_OK version=0 handle=ks1
  replace handle=k1 start=1 end=2 bytes="X" expected_version=0
  expect CDIN_OK new_version=1
  unsubscribe handle=ks1
  expect CDIN_OK
  drain handle=ks1
  expect CDIN_OK count=0
  close_doc handle=k1
  expect CDIN_OK

vector notif.basic.ordering covers NOTIF-001 NOTIF-005 NOTIF-011
  create_doc bytes="abc"
  expect CDIN_OK handle=k1
  subscribe handle=k1
  expect CDIN_OK version=0 handle=ks1
  replace handle=k1 start=1 end=2 bytes="X" expected_version=0
  expect CDIN_OK new_version=1
  replace handle=k1 start=2 end=3 bytes="Y" expected_version=1
  expect CDIN_OK new_version=2
  undo handle=k1 expected_version=2
  expect CDIN_OK new_version=3
  drain handle=ks1
  expect CDIN_OK count=3
  unsubscribe handle=ks1
  expect CDIN_OK
  close_doc handle=k1
  expect CDIN_OK

vector notif.basic.resync_on_overflow covers NOTIF-007 NOTIF-012
  create_doc bytes="abc"
  expect CDIN_OK handle=k1
  subscribe handle=k1
  expect CDIN_OK version=0 handle=ks1
  replace handle=k1 start=0 end=1 bytes="1" expected_version=0
  expect CDIN_OK new_version=1
  replace handle=k1 start=0 end=1 bytes="2" expected_version=1
  expect CDIN_OK new_version=2
  replace handle=k1 start=0 end=1 bytes="3" expected_version=2
  expect CDIN_OK new_version=3
  replace handle=k1 start=0 end=1 bytes="4" expected_version=3
  expect CDIN_OK new_version=4
  replace handle=k1 start=0 end=1 bytes="5" expected_version=4
  expect CDIN_OK new_version=5
  replace handle=k1 start=0 end=1 bytes="6" expected_version=5
  expect CDIN_OK new_version=6
  replace handle=k1 start=0 end=1 bytes="7" expected_version=6
  expect CDIN_OK new_version=7
  replace handle=k1 start=0 end=1 bytes="8" expected_version=7
  expect CDIN_OK new_version=8
  replace handle=k1 start=0 end=1 bytes="9" expected_version=8
  expect CDIN_OK new_version=9
  replace handle=k1 start=0 end=1 bytes="0" expected_version=9
  expect CDIN_OK new_version=10
  drain handle=ks1
  expect CDIN_OK count=1 kind=resync current_version=10
  unsubscribe handle=ks1
  expect CDIN_OK
  close_doc handle=k1
  expect CDIN_OK
