vector text.regions.classification_follows_edit covers TEXT-010 TEXT-011 TEXT-013
  create_doc bytes="\xE2\x80"
  expect CDIN_OK handle=k1
  check_position handle=k1 offset=1
  expect CDIN_OK valid=1
  replace handle=k1 start=2 end=2 bytes="\x80" expected_version=0
  expect CDIN_OK new_version=1
  read handle=k1 start=0 end=3
  expect CDIN_OK data="\xE2\x80\x80"
  check_position handle=k1 offset=1
  expect CDIN_INVALID_POSITION
  close_doc handle=k1
  expect CDIN_OK

