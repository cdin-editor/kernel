vector text.regions.e2_80_41 covers TEXT-010 TEXT-011 TEXT-012 POS-020 POS-021
  create_doc bytes="\xE2\x80\x41"
  expect CDIN_OK handle=k1
  check_position handle=k1 offset=0
  expect CDIN_OK valid=1
  check_position handle=k1 offset=1
  expect CDIN_OK valid=1
  check_position handle=k1 offset=2
  expect CDIN_OK valid=1
  check_position handle=k1 offset=3
  expect CDIN_OK valid=1
  byte_to_codepoint handle=k1 offset=1
  expect CDIN_OK codepoint=1
  byte_to_codepoint handle=k1 offset=2
  expect CDIN_OK codepoint=2
  read handle=k1 start=0 end=3
  expect CDIN_OK data="\xE2\x80\x41"
  close_doc handle=k1
  expect CDIN_OK

