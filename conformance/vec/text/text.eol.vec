vector text.eol.style_follows_edit covers TEXT-021 TEXT-022
  create_doc bytes="a\x0Ab"
  expect CDIN_OK handle=k1
  eol_style handle=k1
  expect CDIN_OK style=lf
  replace handle=k1 start=1 end=1 bytes="\x0D" expected_version=0
  expect CDIN_OK new_version=1
  eol_style handle=k1
  expect CDIN_OK style=crlf
  replace handle=k1 start=2 end=3 bytes="" expected_version=1
  expect CDIN_OK new_version=2
  eol_style handle=k1
  expect CDIN_OK style=cr
  line_count handle=k1
  expect CDIN_OK count=2
  close_doc handle=k1
  expect CDIN_OK

